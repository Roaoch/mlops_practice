pipeline {
    agent any
    
    environment {
        WORKDIR="lab1"
        PYTHON="${isUnix() ? 'python3' : 'python'}"
    }
    
    stages {
        stage("Clone") {
            steps {
                git branch: "master", url: "https://github.com/Roaoch/mlops_practice.git"
            }
        }
        stage("Python Prepare") {
            steps {
                dir(WORKDIR) {
                    sh "${PYTHON} -m venv .venv"
                    sh ".venv/bin/pip install -r requirements.txt"
                }
            }
        }
        stage("Data Create") {
            steps {
                dir(WORKDIR) {
                    sh ".venv/bin/python data_creation.py"
                }
            }
        }
        stage("Data Preprocess") {
            steps {
                dir(WORKDIR) {
                    sh ".venv/bin/python data_preprocessing.py"
                }
            }
        }
        stage("Model Train") {
            steps {
                dir(WORKDIR) {
                    sh ".venv/bin/python model_preparation.py"
                }
            }
        }
        stage("Model Test") {
            steps {
                dir(WORKDIR) {
                    sh ".venv/bin/python model_testing.py"
                }
            }
        }
    }
}
